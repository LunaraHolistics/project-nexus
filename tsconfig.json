{
  "compilerOptions": {
    /* ====== Language & Module ====== */
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    /* ====== Type Resolution ====== */
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* ====== Path Aliases ====== */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@telas/*": ["./telas-individuais/*"],
      "@assets/*": ["./assets/*"]
    },

    /* ====== Quality & Safety ====== */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "**/*.js",
    "**/*.ts",
    "vite.config.js",
    "vite.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.js",
    "**/*.test.js"
  ]
}